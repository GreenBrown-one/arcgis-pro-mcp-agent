{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArcGIS Pro 智能助手",
  "version": "0.2.0-preview.1",
  "identifier": "com.arcgisproagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ArcGIS Pro 智能助手",
        "width": 1280,
        "height": 800,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": false
  }
}
